# Postgres connection string used by packages/db (Prisma) and apps/web, apps/worker.
DATABASE_URL="postgresql://user:password@localhost:5432/sla_breach_monitoring?schema=public"

# apps/web
# Also doubles as the key material for encrypting Zendesk/Jira/Slack client
# secrets saved from the Integrations settings UI (see @sla/db's
# encryptSecret/decryptSecret) — required for those to work, not just auth.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# encryptSecret/decryptSecret) — required.
INTEGRATION_CONFIG_ENCRYPTION_KEY=""

# Zendesk, Jira, and Slack OAuth app credentials (client ID + secret) are no
# longer read from here — each organization configures its own from
# Settings > Integrations, stored in the integration_configs table. The
# *_CLIENT_ID/*_CLIENT_SECRET vars below are kept only as a legacy fallback
# for installs that connected before that UI existed; a value saved in the
# UI always takes priority over these. Redirect URIs registered with each
# provider must still be {NEXTAUTH_URL}/api/integrations/{provider}/callback.
#
# ZENDESK_CLIENT_ID=""
# ZENDESK_CLIENT_SECRET=""
# JIRA_CLIENT_ID=""
# JIRA_CLIENT_SECRET=""
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""

# Linear OAuth app (read-only "read" scope). Redirect URI registered with
# Linear must be {NEXTAUTH_URL}/api/integrations/linear/callback. Linear is
# disabled in the UI and still env-only — out of scope for the per-org
# integration configuration above.
LINEAR_CLIENT_ID=""
LINEAR_CLIENT_SECRET=""

# SMTP server for email notifications (apps/worker) — the second alert
# channel alongside Slack. Standard username/password auth. SMTP_SECURE
# "true" is for an implicit-TLS port (typically 465); leave "false" for
# STARTTLS on ports like 587. Recipients are every User's email in the
# organization — there is no separate connect/settings step.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# apps/worker
POLL_INTERVAL_ACTIVE_SET_MINUTES=5
POLL_INTERVAL_RECONCILIATION_MINUTES=60
