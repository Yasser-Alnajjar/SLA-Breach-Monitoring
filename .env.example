# Postgres connection string used by packages/db (Prisma) and apps/web, apps/worker.
DATABASE_URL="postgresql://user:password@localhost:5432/sla_breach_monitoring?schema=public"

# apps/web
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Zendesk OAuth app (read-only "read" scope). Redirect URI registered with
# Zendesk must be {NEXTAUTH_URL}/api/integrations/zendesk/callback.
ZENDESK_CLIENT_ID=""
ZENDESK_CLIENT_SECRET=""

# Jira OAuth 2.0 (3LO) app (read-only "read:jira-work offline_access" scopes).
# Redirect URI registered with Atlassian must be
# {NEXTAUTH_URL}/api/integrations/jira/callback.
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""

# Linear OAuth app (read-only "read" scope). Redirect URI registered with
# Linear must be {NEXTAUTH_URL}/api/integrations/linear/callback.
LINEAR_CLIENT_ID=""
LINEAR_CLIENT_SECRET=""

# Slack app (bot scopes "chat:write,chat:write.public,channels:read,groups:read").
# Redirect URI registered with Slack must be
# {NEXTAUTH_URL}/api/integrations/slack/callback.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# SMTP server for email notifications (apps/worker) — the second alert
# channel alongside Slack. Standard username/password auth. SMTP_SECURE
# "true" is for an implicit-TLS port (typically 465); leave "false" for
# STARTTLS on ports like 587. Recipients are every User's email in the
# organization — there is no separate connect/settings step.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# apps/worker
POLL_INTERVAL_ACTIVE_SET_MINUTES=5
POLL_INTERVAL_RECONCILIATION_MINUTES=60
