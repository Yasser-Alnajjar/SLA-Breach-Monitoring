# Production environment for docker-compose.prod.yml. See docs/deployment.md.
#
# Copy to `.env.prod` on the host and fill in real values:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   scripts/rotate-secrets.sh .env.prod   # fills in every generated secret
# `.env.prod` is gitignored. Never commit it.

# Database (bundled postgres service reads these; web/worker read DATABASE_URL)
POSTGRES_USER=sla
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sla_breach_monitoring
# The password here must match POSTGRES_PASSWORD. The host is `postgres`, the
# Compose service name, unless you point this at your own database.
DATABASE_URL=postgresql://sla:change-me@postgres:5432/sla_breach_monitoring?schema=public

# web
# openssl rand -base64 32
NEXTAUTH_SECRET=change-me
# The exact public origin, e.g. https://sla.example.com
NEXTAUTH_URL=https://sla.example.com
# Comma-separated emails of the platform operators who run this deployment.
# Only these accounts may change Worker/Monitoring settings; every tenant,
# including an org owner, gets a read-only view.
PLATFORM_ADMIN_EMAILS=

# web + worker. Three independent keys: `openssl rand -base64 32` each.
# Changing any one of them later makes data already encrypted with it
# unreadable.
INTEGRATION_CONFIG_ENCRYPTION_KEY=change-me
SMTP_ENCRYPTION_KEY=change-me
INTEGRATION_TOKEN_ENCRYPTION_KEY=change-me

# web: deployment-level SMTP for account-lifecycle email (invitations,
# password resets, email verification — roadmap D8). Deliberately separate
# from any organization's own saved SMTP (Settings → Notifications) and
# from OPS_ALERT_SMTP_* below — these flows can fire before an organization
# has configured anything of its own. Required for invitations, password
# resets and email verification to work.
TRANSACTIONAL_SMTP_HOST=
TRANSACTIONAL_SMTP_PORT=587
TRANSACTIONAL_SMTP_SECURITY=starttls
TRANSACTIONAL_SMTP_USER=
TRANSACTIONAL_SMTP_PASSWORD=
TRANSACTIONAL_SMTP_FROM=

# web: how many reverse proxies sit in front of it, so the rate limiter reads
# the real client IP from X-Forwarded-For. 1 = just Caddy/nginx/Traefik on
# this host; 2 = a CDN or load balancer in front of that proxy.
TRUSTED_PROXY_COUNT=1
# web: host interface its port binds to. Keep 127.0.0.1 unless the reverse
# proxy runs on a different machine.
WEB_BIND=127.0.0.1

# worker (optional — these are the defaults if omitted)
WORKER_ACTIVE_POLL_MS=300000
WORKER_RECONCILIATION_MS=3600000

SENTRY_DSN=
# apps/worker only — the port its liveness endpoint (GET /health) listens
# on inside the container. Must match apps/worker/Dockerfile's HEALTHCHECK
# and docker-compose.prod.yml's worker `expose` if you change it.
WORKER_HEALTH_PORT=8081
WORKER_LOCK_RETRY_MS=15000
WORKER_LOCK_PING_MS=30000
# apps/worker only — where a "worker cycle hasn't completed in a while"
# alert goes (this is for you, the deployment owner, not your customers —
# their SLA breach alerts are the separate per-organization Slack/email
# channels configured from the app's own Notifications settings). Slack
# uses a plain incoming-webhook URL, not the per-org Slack OAuth app.
OPS_ALERT_SLACK_WEBHOOK_URL=
# Email needs both a recipient and its own SMTP credentials — deliberately
# separate from any organization's saved SMTP settings, since this alert
# must still reach you even if a customer's own email config is broken.
OPS_ALERT_EMAIL=
OPS_ALERT_SMTP_HOST=
OPS_ALERT_SMTP_PORT=587
OPS_ALERT_SMTP_SECURITY=starttls
OPS_ALERT_SMTP_USER=
OPS_ALERT_SMTP_PASSWORD=
OPS_ALERT_SMTP_FROM=
