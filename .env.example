# Postgres connection string used by packages/db (Prisma) and apps/web, apps/worker.
DATABASE_URL="postgresql://user:password@localhost:5432/sla_breach_monitoring?schema=public"

# apps/web
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Comma-separated emails of the platform operators who run this deployment.
# Only these accounts (checked server-side, not a UserRole) may change
# Worker/Monitoring settings; every tenant, including an org owner, gets a
# read-only view.
PLATFORM_ADMIN_EMAILS=""
# Dedicated key material for encrypting/decrypting the Zendesk/Jira/Slack
# client secrets saved from the Integrations settings UI (see @sla/db's
# encryptSecret/decryptSecret) — kept separate from NEXTAUTH_SECRET so
# rotating one never invalidates the other. Required for those integrations
# to work.
INTEGRATION_CONFIG_ENCRYPTION_KEY=""
# Dedicated key material for encrypting/decrypting the OAuth access/refresh
# tokens saved for each connected Zendesk/Jira/Intercom/Linear/GitHub/Slack
# integration (see @sla/db's encryptCredentials/decryptCredentials) — kept
# separate from INTEGRATION_CONFIG_ENCRYPTION_KEY/NEXTAUTH_SECRET/
# SMTP_ENCRYPTION_KEY so rotating one never invalidates the others. Required
# for connecting any integration to work. Existing plaintext rows from
# before this key existed are migrated in place with `pnpm db:encrypt-tokens`.
INTEGRATION_TOKEN_ENCRYPTION_KEY=""

# Email notifications (the second alert channel alongside Slack) are
# configured per-organization from the Notifications settings UI, stored in
# `OrganizationEmailSettings` — there is no deployment-level SMTP_HOST/
# SMTP_USER/etc fallback. This is the one deployment-level secret the
# feature still needs: the key used to encrypt/decrypt each organization's
# saved SMTP password at rest (see @sla/db's encryptSmtpPassword/
# decryptSmtpPassword) — kept separate from INTEGRATION_CONFIG_ENCRYPTION_KEY/
# NEXTAUTH_SECRET so rotating one never invalidates the others. Required for
# the Notifications settings UI's email configuration to work.
SMTP_ENCRYPTION_KEY=""

# apps/worker
WORKER_ACTIVE_POLL_MS=300000
WORKER_RECONCILIATION_MS=3600000

# Observability (apps/web, apps/worker) — see docs/deployment.md's "Health
# checks and observability" section. Every var below is optional; leaving
# any of them blank just skips that feature/channel, never a crash — the
# same "missing credentials mean skip" convention as everything else here.
#
# Error tracking (e.g. https://sentry.io). Read by both apps
# (apps/web/sentry.{server,edge}.config.ts, apps/worker/src/sentry.ts).
SENTRY_DSN=""
# apps/worker only — the port its liveness endpoint (GET /health) listens
# on inside the container. Must match apps/worker/Dockerfile's HEALTHCHECK
# and docker-compose.prod.yml's worker `expose` if you change it.
WORKER_HEALTH_PORT=8081
# apps/worker only — only one worker may run cycles per database (roadmap
# step 42). Extra instances wait in standby and retry the Postgres advisory
# lock this often; the active one pings its lock connection this often.
WORKER_LOCK_RETRY_MS=15000
WORKER_LOCK_PING_MS=30000
# apps/worker only — where a "worker cycle hasn't completed in a while"
# alert goes (this is for you, the deployment owner, not your customers —
# their SLA breach alerts are the separate per-organization Slack/email
# channels configured from the app's own Notifications settings). Slack
# uses a plain incoming-webhook URL, not the per-org Slack OAuth app.
OPS_ALERT_SLACK_WEBHOOK_URL=""
# Email needs both a recipient and its own SMTP credentials — deliberately
# separate from any organization's saved SMTP settings, since this alert
# must still reach you even if a customer's own email config is broken.
OPS_ALERT_EMAIL=""
OPS_ALERT_SMTP_HOST=""
OPS_ALERT_SMTP_PORT=587
OPS_ALERT_SMTP_SECURITY=starttls
OPS_ALERT_SMTP_USER=""
OPS_ALERT_SMTP_PASSWORD=""
OPS_ALERT_SMTP_FROM=""
