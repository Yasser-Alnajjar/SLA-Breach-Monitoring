{
  "name": "sla-breach-monitoring",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "web:dev": "pnpm -r --filter=./apps/web dev",
    "web:build": "pnpm -r --filter=./apps/web build",
    "worker:dev": "pnpm -r --filter=./apps/worker dev",
    "worker:start": "pnpm -r --filter=./apps/worker start",
    "worker:build": "pnpm -r --filter=./apps/worker build",
    "type-check": "pnpm -r run type-check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
